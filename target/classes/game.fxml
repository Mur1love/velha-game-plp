<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" styleClass="game-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.velha.GameController">
    <Label styleClass="title" text="Jogo da Velha" />
    <Label fx:id="statusLabel" styleClass="status" text="Vez do jogador: X" />
    <Label fx:id="timerLabel" styleClass="timer" text="Tempo: 10s" />
    <GridPane fx:id="boardGrid" hgap="5" styleClass="board" vgap="5" />
</VBox>
